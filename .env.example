# ------------------------------------------------------------------
# AgentForge environment overrides.
# Copy to `.env` in the repository root and fill in what applies.
# scripts/run_workflow.py loads this file into the process environment
# before spawning omnigent.
# ------------------------------------------------------------------

# Codex CLI binary (absolute path).
# The Codex desktop app bundles its CLI but does not add it to PATH, and
# omnigent's harness readiness check resolves `codex` from PATH.
# Windows example:
#   OMNIGENT_CODEX_PATH=C:\Users\<you>\AppData\Local\OpenAI\Codex\bin\<build-hash>\codex.exe
# If you instead have a `codex` shim on PATH, this can stay empty.
OMNIGENT_CODEX_PATH=

# Model-provider pin for the codex harness. Leave EMPTY in the recommended
# setup: register your provider in ~/.omnigent/config.yaml as kind
# `cli-config` instead (see docs/setup.md "Non-OpenAI model routing") —
# omnigent then pins the provider per session itself.
# Only set this (e.g. "openai") to force a specific built-in provider.
HARNESS_CODEX_MODEL_PROVIDER=

# zcode-acp bridge entry point (absolute path to dist/index.js).
# Leave EMPTY when the `zcode-acp-server` package is installed globally or
# resolvable from adapters/zcode-acp — the adapter resolves it automatically.
ZCODE_ACP_BRIDGE=

# Per-turn timeout in seconds for one-shot workflow runs.
# omnigent's one-shot CLI path hard-codes 120s per turn, which is too short
# for multi-role workflows (planner -> executor -> reviewer run inside one
# turn). scripts/run_workflow.py patches this to the value below.
AGENTFORGE_TURN_TIMEOUT=1800
